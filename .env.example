# Razorpay Test Mode Keys (Get these from your Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# The MCP Token is just: Base64(key_id:key_secret)
# You can generate it by running: echo -n "rzp_test_KEY:SECRET" | base64
RAZORPAY_MCP_TOKEN=BASE64_ENCODED_KEY_ID_COLON_KEY_SECRET

# Database & Cache settings (Leave these as they are for Docker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=payagent
POSTGRES_PASSWORD=payagent_secret
POSTGRES_DB=payagent
REDIS_URL=redis://redis:6379

# Internal API Keys (For Go and Python to talk securely)
MERCHANT_API_KEY=internal-agent-api-key-change-in-prod
MERCHANT_BASE_URL=http://merchant-server:8080
RAZORPAY_MCP_URL=http://razorpay-mcp:3000
